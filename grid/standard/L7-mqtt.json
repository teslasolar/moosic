    "DBIRTH": "device online", "DDEATH": "device offline",
    "NDATA": "node data", "DDATA": "device data",
    "NCMD": "cmd→node", "DCMD": "cmd→device"
  },
  "format": "spBv1.0/{group}/{msgtype}/{edge}/{device}"
}
