  "_udt": "KonomiStandard", "layer": 7, "name": "MQTT+Sparkplug", "scope": "Lightweight PubSub",
  "qos": { "0": "AtMostOnce", "1": "AtLeastOnce", "2": "ExactlyOnce" },
